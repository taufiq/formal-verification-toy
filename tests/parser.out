Grammar

Rule 0     S' -> program
Rule 1     program -> function_list
Rule 2     function_list -> function_declaration
Rule 3     function_list -> function_declaration function_list
Rule 4     statement_list -> statement
Rule 5     statement_list -> statement statement_list
Rule 6     statement_list -> statement_with_no_semi_col statement_list
Rule 7     statement_list -> statement_with_no_semi_col
Rule 8     statement_list -> NOP SEMICOLON
Rule 9     statement_list -> NOP statement_list
Rule 10    statement_with_no_semi_col -> while_loop
Rule 11    statement_with_no_semi_col -> if_then_else
Rule 12    statement -> assignment SEMICOLON
Rule 13    statement -> expression SEMICOLON
Rule 14    statement -> annotation SEMICOLON
Rule 15    statement -> assumption SEMICOLON
Rule 16    statement -> return_statement SEMICOLON
Rule 17    function_declaration -> BOOL_TYPE FUNCTION VARIABLE LPAREN parameter_list RPAREN LBRACE function_body RBRACE
Rule 18    function_declaration -> INT_TYPE FUNCTION VARIABLE LPAREN parameter_list RPAREN LBRACE function_body RBRACE
Rule 19    function_body -> DECLARE LPAREN parameter_list RPAREN SEMICOLON statement_list
Rule 20    function_body -> statement_list
Rule 21    return_statement -> RETURN expression
Rule 22    parameter_list -> declaration
Rule 23    parameter_list -> declaration COMMA parameter_list
Rule 24    while_loop -> WHILE LPAREN expression RPAREN LBRACE statement_list RBRACE
Rule 25    declaration -> BOOL_TYPE VARIABLE
Rule 26    declaration -> INT_TYPE VARIABLE
Rule 27    annotation -> PRE_ANNOTATION expression
Rule 28    annotation -> POST_ANNOTATION expression
Rule 29    annotation -> LOOP_ANNOTATION expression
Rule 30    assumption -> ASSUME expression
Rule 31    assignment -> VARIABLE ASSIGNMENT expression
Rule 32    expression -> expression PLUS expression
Rule 33    expression -> expression MINUS expression
Rule 34    expression -> expression TIMES expression
Rule 35    expression -> LPAREN expression RPAREN
Rule 36    expression -> NUMBER
Rule 37    expression -> TRUE
Rule 38    expression -> FALSE
Rule 39    expression -> VARIABLE
Rule 40    expression -> MINUS expression
Rule 41    expression -> expression COMPARATOR expression
Rule 42    expression -> expression BOOLEAN_OPERATOR expression
Rule 43    expression -> expression IMPLIES expression
Rule 44    expression -> NOT LPAREN expression RPAREN
Rule 45    if_then_else -> IF LPAREN expression RPAREN LBRACE statement_list RBRACE ELSE LBRACE statement_list RBRACE


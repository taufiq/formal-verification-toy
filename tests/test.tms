
INT FUNCTION aFunction(INT a, INT b) {
    DECLARE (INT x, BOOL z)
    @Pre a < b
    @Post a >= b
    @Loop a <= b
    WHILE (a < b) {
        a := a + 1
    }
    return a
}



INT FUNCTION randomFunction(INT a, INT b) {
    @Pre a < b
    @Post a > b
    IF (a == 5) {
        a := b + 1
    } ELSE {
        a := b + 2
    }
    return a
}
